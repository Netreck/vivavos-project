# ==============================================================================
# CONFIGURAÇÕES DO VIVAVÓS
# ==============================================================================

# Chave da API da OpenAI (com suporte a visão, ex: gpt-4o ou gpt-4o-mini)
OPENAI_API_KEY=sua-chave-aqui

# Modelo padrão (ex: gpt-4o-mini ou gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Provedor de visão (padrão: openai)
VISION_PROVIDER=openai

# Porta do servidor de desenvolvimento
PORT=5173
