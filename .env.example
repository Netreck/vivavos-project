# ==============================================================================
# CONFIGURAÇÕES DO VIVAVÓS
# Copie este arquivo para .env e preencha a sua chave. Nunca envie o .env ao GitHub.
# ==============================================================================

# Chave da API da OpenAI (leitura das fotos e voz em português do Brasil)
OPENAI_API_KEY=sua-chave-aqui

# Modelo de visão usado para ler caixas de remédio e exames
OPENAI_MODEL=gpt-4o-mini

# Voz falada (opcional)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Provedor de visão (padrão: openai)
VISION_PROVIDER=openai
